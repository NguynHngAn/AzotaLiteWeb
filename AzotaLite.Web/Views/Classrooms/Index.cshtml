@model IEnumerable<AzotaLite.Web.Models.Classroom>
@{
    ViewData["Title"] = "My Classrooms";
}
<h2>@ViewData["Title"]</h2>
<p class="text-success">@TempData["Msg"]</p>

<form method="get" class="mb-3">
    <input name="q" class="form-control" placeholder="Tìm theo tên lớp..." value="@Context.Request.Query["q"]" />
</form>

<p><a asp-action="Create" class="btn btn-primary">Tạo lớp</a></p>

<table class="table table-striped">
    <thead><tr><th>Tên lớp</th><th>Khối</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Grade</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-secondary">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
